@startuml Class Diagram
title Class Diagram

skinparam shadowing true
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide circle
scale 2


' =========================================================
' Account
' =========================================================

interface "Account" as Account <<interface>> {
  - id : String
  - passwd : String
  - type : String
  --
  + login() : Boolean
  + logout() : void
}


' =========================================================
' User
' =========================================================

class "User" as User {
  - isLogin : Boolean
  --
  + initialize(id : String, passwd : String) : void
  + registerPaymentMethod(type : String) : void
}


' =========================================================
' Account Manager
' 회원정보 등록 및 계정 관리
' =========================================================

class "AccountManager" as AccountManager <<control>> {
  --
  + openRegistrationPage() : void
  + enterPersonalInformation(id : String, passwd : String) : void
  + submitRegistration() : void
  + validateRegistration(id : String, passwd : String) : String
  + registerUser(id : String, passwd : String) : User
  + notifyRegistrationComplete(user : User) : void
  + displayErrorMessage(error : String) : void
}


' =========================================================
' Payment Method
' =========================================================

class "PaymentMethod" as PaymentMethod {
  - type : String
  - accountNumber : String
  - isValid : Boolean
  - linkedTime : DateTime
}


' =========================================================
' Voucher Wallet
' =========================================================

class "VoucherWallet" as VoucherWallet {
  - balance : Money
  --
  + checkBalance() : String
  + charge() : Boolean
}


' =========================================================
' Transaction
' =========================================================

class "Transaction" as Transaction {
  - type : String
  - amount : Money
  - dateTime : DateTime
  - status : String
  --
  + pay() : Boolean
  + cancel() : Boolean
}


' =========================================================
' Merchant
' =========================================================

class "Merchant" as Merchant {
  - mid : Account
  - category : BusinessCategory
  - location : Address
  - operationHours : String
  - status : String
  --
  + updateInfo() : void
  + checkStatus() : String
  + processPayment(amount : Money) : Boolean
  + cancelPayment(transactionId : String) : Boolean
}


' =========================================================
' Merchant Register Manager
' =========================================================

class "MerchantRegisterManager" as Application {
  - type : String
  - status : String
}


' =========================================================
' Settlement
' =========================================================

class "SettlementManager" as Settlement {
  - period : String
  - amount : Money
  - fee : Money
  - isCompleted : Boolean
}


' =========================================================
' Admin
' =========================================================

class "Admin" as Admin {
  - aid : Account
  --
  + reviewMerchantRegister(manager : MerchantRegisterManager) : void
  + approveMerchantRegister(manager : MerchantRegisterManager) : void
  + rejectMerchantRegister(manager : MerchantRegisterManager) : void
  + updatePolicy(policy : Policy) : void


}


' =========================================================
' Policy
' =========================================================

class "Policy" as Policy {
  - purchaseLimit : Money
  - restrictedCategories : List<String>
  --
  + getPurchaseLimit() : Money
  + updatePurchaseLimit(newLimit : Money) : Boolean 
  + checkLimit(amount : Money) : Boolean
  + isCategoryAllowed(category : String) : Boolean
}


' =========================================================
' Business Category
' =========================================================

class "BusinessCategory" as BusinessCategory {
  - categoryId : Int
  - name : String
  - isAllowed : Boolean
  --
  + checkRestrictionStatus() : Boolean
  + restrict() : void
  + allow() : void
}


' =========================================================
' Region
' =========================================================

class "Region" as Region {
  - name : String
  --
  + getPolicy() : Policy
  + getMerchants() : List<Merchant>
  + isMerchantInRegion(merchant : Merchant) : Boolean
}


' =========================================================
' Merchant Owner
' =========================================================

class "MerchantOwner" as MerchantOwner {
  - aid : Account
  - merchantList : List<Merchant>
  --
  + registerMerchant() : Boolean
}


' =========================================================
' Account 구현 관계
' =========================================================

Account <|.. User
Account <|.. MerchantOwner
Account <|.. Admin


' =========================================================
' AccountManager 관계
' =========================================================

AccountManager ..> Account
AccountManager ..> User


' =========================================================
' User 소유 관계
' =========================================================

User *-- PaymentMethod
User *-- VoucherWallet


' =========================================================
' VoucherWallet / Region / Transaction
' =========================================================

VoucherWallet ..> Region
VoucherWallet *-- Transaction


' =========================================================
' Transaction
' =========================================================

Transaction --> PaymentMethod
Transaction --> Merchant


' =========================================================
' MerchantOwner / Application / Merchant
' =========================================================

MerchantOwner --> Application
MerchantOwner --> Merchant


' =========================================================
' Application / BusinessCategory
' =========================================================

Application --> BusinessCategory


' =========================================================
' Application / Policy / Merchant
' =========================================================

Application ..> Policy
Application ..> Merchant


' =========================================================
' Merchant / BusinessCategory
' =========================================================

Merchant --> BusinessCategory


' =========================================================
' Policy / BusinessCategory
' =========================================================

Policy --> BusinessCategory


' =========================================================
' Admin / Policy / Application
' =========================================================

Admin --> Policy
Admin --> Application
Admin ..> BusinessCategory


' =========================================================
' Region / Policy / Merchant
' =========================================================

Region *-- Policy
Region --> Merchant


' =========================================================
' Settlement
' =========================================================

Settlement --> Transaction
Settlement --> Merchant

@enduml


